# Copy this file to `.env` and fill in your key.
#   cp .env.example .env

# Same key you used in the Module 2 tool-calling lecture.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me

# Optional. If this model ever gets retired, swap it here and nothing else breaks.
# Other good options: openai/gpt-oss-120b, moonshotai/kimi-k2-instruct
GROQ_MODEL=llama-3.3-70b-versatile
